# Local Docker Compose settings. Copy to infra/docker/.env (git-ignored) or run `make doctor`,
# which creates it and fills in UID/GID/HOST_OS/HOST_ARCH. Fake local-only values; never real secrets.

# Written by scripts/preflight.py
UID=1000
GID=1000
HOST_OS=linux
HOST_ARCH=amd64
# Set only when an image has no build for your CPU, e.g. linux/amd64 on Apple Silicon.
DOCKER_PLATFORM=

POSTGRES_DB=college_management
POSTGRES_USER=postgres
# Only applied when the postgres_data volume is first created; existing volumes keep their password.
POSTGRES_PASSWORD=postgres

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local-only

# Host ports (bound to 127.0.0.1). DB_PORT/ES_PORT are used only with compose.debug.yaml.
API_PORT=8080
WEB_PORT=5173
PGADMIN_PORT=5050
KIBANA_PORT=5601
DB_PORT=5433
ES_PORT=9200
