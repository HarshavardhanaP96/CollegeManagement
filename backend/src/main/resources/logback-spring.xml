<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="edgepoint-api"/>

    <!-- Structured JSON to stdout — works with any log collector (kubectl logs, Fluent Bit,
         CloudWatch, etc.) without running a separate log-shipping server. Replaces the previous
         LogstashTcpSocketAppender, which required a reachable Logstash host and otherwise
         retried a failing connection every ~30s. -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app_name":"${appName}"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>
</configuration>
